{
  "name": "dbschemix/core",
  "description": "dbschemix: database migration core",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Dmitriy Krivopalov",
      "email": "dimarik82@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/dbschemix/core/issues",
    "source": "https://github.com/dbschemix/core"
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "buggregator/trap": "^1.15",
    "infection/infection": "^0.32.4",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-latest",
    "slevomat/coding-standard": "^8.7",
    "squizlabs/php_codesniffer": "^3.7",
    "vimeo/psalm": "^6.13"
  },
  "autoload": {
    "psr-4": {
      "dbschemix\\core\\": "src"
    },
    "files": [
      "src/internal/filesystem/functions.php",
      "src/package/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "dbschemix\\core\\tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "fix": [
      "@phpcbf",
      "@rector"
    ],
    "check": [
      "@phpcs",
      "@psalm",
      "@phpstan"
    ],
    "phpcbf": "vendor/bin/phpcbf",
    "rector": "vendor/bin/rector",
    "phpcs": "vendor/bin/phpcs",
    "psalm": "vendor/bin/psalm --show-info --no-diff --no-cache",
    "phpstan": "vendor/bin/phpstan analyze -c phpstan.neon"
  },
  "prefer-stable": true
}
